{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"sourceMap": false,
		"declaration": true,
		"removeComments": false,
		"skipLibCheck": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"strict": false,
		"strictNullChecks": false,
		"useUnknownInCatchVariables": false,
		"alwaysStrict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"lib": [
			"dom",
			"esnext"
		]
	},
	"lib": [
		"esnext"
	],
	"exclude": [
		"node_modules",
		"src"
	],
	"include": [
		"./**/*.ts",
		"../dist/**/*.d.ts"
	]
}
